# Copy this file to .env.local and replace the placeholders with values from Supabase.
# These two NEXT_PUBLIC_ variables are required by the browser-side Supabase client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional server-only secret. Keep blank unless a server-only feature explicitly requires it.
# Never commit a real secret key or expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
